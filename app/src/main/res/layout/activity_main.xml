<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elder_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/elder_primary"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <Button
                    android:id="@+id/btnBackToList"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="start"
                    android:backgroundTint="@color/elder_primary_dark"
                    android:text="@string/btn_back"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvHouse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/main_subtitle"
                    android:textColor="#EAF2FF"
                    android:textSize="16sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/elder_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/elder_surface_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_apartment"
                    android:textColor="@color/elder_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etApartment"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="@string/hint_apartment"
                    android:importantForAutofill="yes"
                    android:inputType="text"
                    android:padding="16dp"
                    android:textColor="@color/elder_text"
                    android:textColorHint="@color/elder_text_muted"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/hint_qr"
                    android:textColor="@color/elder_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etQrId"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:drawable/edit_text"
                    android:focusable="false"
                    android:hint="@string/hint_qr"
                    android:padding="16dp"
                    android:textColor="@color/elder_text"
                    android:textColorHint="@color/elder_text_muted"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScan"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_scan"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    app:backgroundTint="@color/elder_primary"
                    app:cornerRadius="18dp"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/section_comment"
                    android:textColor="@color/elder_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etComment"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:drawable/edit_text"
                    android:gravity="top"
                    android:hint="@string/hint_comment"
                    android:inputType="textMultiLine"
                    android:padding="16dp"
                    android:textColor="@color/elder_text"
                    android:textColorHint="@color/elder_text_muted"
                    android:textSize="18sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/elder_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/elder_surface_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_photos"
                    android:textColor="@color/elder_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPhotoBefore"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/btn_photo_before"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    app:backgroundTint="@color/elder_success"
                    app:cornerRadius="18dp"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/elder_surface_soft"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/elder_surface_soft"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imgBefore"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:background="@color/elder_surface_soft"
                            android:contentDescription="@string/hint_before"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/empty_photo_preview"
                            android:textColor="@color/elder_text_muted"
                            android:textSize="16sp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPhotoAfter"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/btn_photo_after"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    app:backgroundTint="@color/elder_primary"
                    app:cornerRadius="18dp"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/elder_surface_soft"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/elder_surface_soft"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imgAfter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:background="@color/elder_surface_soft"
                            android:contentDescription="@string/hint_after"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/empty_photo_preview"
                            android:textColor="@color/elder_text_muted"
                            android:textSize="16sp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/elder_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/elder_surface_soft"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_options"
                    android:textColor="@color/elder_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/dn_type_title"
                    android:textColor="@color/elder_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgDNType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rgDN15"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_selection_gray_rounded"
                        android:buttonTint="@color/elder_primary"
                        android:checked="true"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:text="@string/dn_15"
                        android:textColor="@color/elder_text"
                        android:textSize="18sp" />

                    <RadioButton
                        android:id="@+id/rgDN20"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_selection_gray_rounded"
                        android:buttonTint="@color/elder_primary"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:text="@string/dn_20"
                        android:textColor="@color/elder_text"
                        android:textSize="18sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/water_type_title"
                    android:textColor="@color/elder_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgWaterType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbCold"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_selection_water_cold_rounded"
                        android:buttonTint="@color/white"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:textColor="@color/white"
                        android:text="@string/water_cold"
                        android:textSize="18sp" />

                    <RadioButton
                        android:id="@+id/rbHot"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_selection_water_hot_rounded"
                        android:buttonTint="@color/white"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:textColor="@color/white"
                        android:text="@string/water_hot"
                        android:textSize="18sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/size_title"
                    android:textColor="@color/elder_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb80"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_selection_gray_rounded"
                        android:buttonTint="@color/elder_primary"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:text="@string/size_80"
                        android:textColor="@color/elder_text"
                        android:textSize="18sp" />

                    <RadioButton
                        android:id="@+id/rb110"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_selection_gray_rounded"
                        android:buttonTint="@color/elder_primary"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:text="@string/size_110"
                        android:textColor="@color/elder_text"
                        android:textSize="18sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/section_kitchen"
                    android:textColor="@color/elder_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgKitchen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbKitchenFloor"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_selection_gray_rounded"
                        android:buttonTint="@color/elder_primary"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:text="@string/room_floor"
                        android:textColor="@color/elder_text"
                        android:textSize="18sp" />

                    <RadioButton
                        android:id="@+id/rbKitchenCeiling"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_selection_gray_rounded"
                        android:buttonTint="@color/elder_primary"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:text="@string/room_ceiling"
                        android:textColor="@color/elder_text"
                        android:textSize="18sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/section_bathroom"
                    android:textColor="@color/elder_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgBathroom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbBathroomFloor"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_selection_gray_rounded"
                        android:buttonTint="@color/elder_primary"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:text="@string/room_floor"
                        android:textColor="@color/elder_text"
                        android:textSize="18sp" />

                    <RadioButton
                        android:id="@+id/rbBathroomCeiling"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_selection_gray_rounded"
                        android:buttonTint="@color/elder_primary"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:text="@string/room_ceiling"
                        android:textColor="@color/elder_text"
                        android:textSize="18sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_save"
            android:textAllCaps="false"
            android:textSize="20sp"
            app:backgroundTint="@color/elder_success"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"
            android:text="@string/btn_clear"
            android:textAllCaps="false"
            android:textSize="20sp"
            app:backgroundTint="@color/elder_danger"
            app:cornerRadius="20dp"
            app:icon="@android:drawable/ic_menu_close_clear_cancel"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
